# Copy to .env (cp .env.example .env) and fill in. Only the LLM scenario lab reads these;
# everything else runs without them. .env is git-ignored: never commit it.
# One KEY=value per line: a value must stay on a single line, and inline comments after a value are not supported.

# LLM backend: claude_code (default: the local Claude Code CLI on your own Claude subscription) or api
MSL_LLM_BACKEND=claude_code
# Optional, claude_code: a token from `claude setup-token`; empty means the CLI's own login (claude auth login)
CLAUDE_CODE_OAUTH_TOKEN=
# Only for MSL_LLM_BACKEND=api (billed per token); the claude_code backend never passes it to the CLI
ANTHROPIC_API_KEY=
# Optional: FRED API key (free). Without it, or when FRED rejects it, the build uses FRED's graph CSV.
FRED_API_KEY=
# Optional: override the model used to translate narratives into scenario specs
# MSL_LLM_MODEL=claude-opus-5-5
# Optional, claude_code: the claude binary when it is not on PATH (default: PATH, then ~/.local/bin/claude)
# MSL_CLAUDE_BIN=/path/to/claude
# Optional: seconds one translation may take, and how many may run at once
# MSL_LLM_TIMEOUT=600
# MSL_LLM_CONCURRENCY=2
# Optional: web server port
# MSL_PORT=8765
