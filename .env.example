# Copy to .env (cp .env.example .env) and fill in. Only the LLM scenario lab needs a key;
# everything else runs without one. .env is git-ignored: never commit it.
# One KEY=value per line; inline comments after a value are not supported.
ANTHROPIC_API_KEY=
# Optional: FRED API key (free). Without it, or when FRED rejects it, the build uses FRED's graph CSV.
FRED_API_KEY=
# Optional: override the model used to translate narratives into scenario specs
# MSL_LLM_MODEL=claude-opus-5-5
# Optional: web server port
# MSL_PORT=8765
